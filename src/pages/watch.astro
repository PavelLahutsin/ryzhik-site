---
import { getCollection, getEntry } from "astro:content";
import Icon from "../components/Icon.astro";
import VideoCard from "../components/VideoCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/base";
import { occasionIds, platform, playlists, videos } from "../lib/catalog";

const page = await getEntry("pages", "watch");
if (!page) throw new Error("Нет текста страницы watch");

const occasions = (await getCollection("occasions")).sort((a, b) => a.data.order - b.data.order);
const vkVideo = platform("vk-video");
const youtube = platform("youtube");
const cards = videos.map((video) => ({
  video,
  occasions: occasionIds(video.title, occasions),
}));
---

<BaseLayout title={`${page.data.title} — Лисёнок Рыжик`} description={page.data.description}>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">{page.data.eyebrow}</p>
      <h1>{page.data.heading}</h1>
      {page.data.lede && <p class="lede">{page.data.lede}</p>}
    </div>
  </section>

  <section class="section section-tight">
    <div class="container">
      <div class="playlist-filters" role="navigation" aria-label="Плейлисты">
        {
          playlists.map((item) => (
            <div class="playlist-filter">
              <a class="chip" href={withBase(`/watch?playlist=${item.id}`)} data-filter-playlist={item.id}>
                {item.title}
              </a>
              <span class="playlist-filter-links">
                <a href={item.vkUrl} target="_blank" rel="noopener noreferrer">Плейлист в VK</a>
                <a href={item.youtubeUrl} target="_blank" rel="noopener noreferrer">Плейлист на YouTube</a>
              </span>
            </div>
          ))
        }
      </div>

      {
        page.data.playlistIntros?.map((item) => (
          <p class="filter-banner" data-playlist-banner={item.id} hidden>
            {item.text}
          </p>
        ))
      }

      {
        occasions.map((item) => (
          <p class="filter-banner" data-occasion-banner={item.id} hidden>
            Подборка «{item.data.title}»: ролики, в названии которых есть слова этой темы.{" "}
            <a href={withBase("/watch")}>Показать все</a>
          </p>
        ))
      }

      <p class="empty-note" data-empty hidden>По этому фильтру роликов нет.</p>

      <div class="episodes">
        {
          cards.map(({ video, occasions: tags }) => (
            <VideoCard
              id={video.id}
              title={video.title}
              thumbnail={video.thumbnail}
              durationSeconds={video.durationSeconds}
              uploadDate={video.uploadDate}
              href={video.watchUrl}
              playlists={video.playlists}
              occasions={tags}
              vk={video.vk}
              youtubeId={video.youtubeId}
              external
            />
          ))
        }
      </div>
    </div>
  </section>

  <dialog class="player-dialog" id="player-dialog" aria-labelledby="player-title">
    <div class="player-sheet">
      <h2 id="player-title" class="sr-only">Просмотр ролика</h2>
      <div data-player-frame></div>
      <div class="player-toolbar">
        <div class="player-switch" role="group" aria-label="Плеер">
          <button type="button" data-player-platform="vk" aria-pressed="true">VK</button>
          <button type="button" data-player-platform="youtube" aria-pressed="false">YouTube</button>
        </div>
        <button class="btn btn-ghost" type="button" data-player-close>Закрыть</button>
      </div>
      <div class="player-links">
        <a class="btn btn-emerald" data-player-vk href={vkVideo.href} target="_blank" rel="noopener noreferrer">
          <Icon name="vk" />
          Открыть в VK
        </a>
        <a class="btn btn-orange" data-player-yt href={youtube.href} target="_blank" rel="noopener noreferrer">
          <Icon name="youtube" />
          Открыть на YouTube
        </a>
      </div>
    </div>
  </dialog>

  <script is:inline>
    (function () {
      var dialog = document.getElementById("player-dialog");
      var frame = document.querySelector("[data-player-frame]");
      var closeButton = document.querySelector("[data-player-close]");
      var vkLink = document.querySelector("[data-player-vk]");
      var ytLink = document.querySelector("[data-player-yt]");
      var platformButtons = document.querySelectorAll("[data-player-platform]");
      var playerChoiceKey = "ryzhik-player";
      var current = { vkSrc: "", ytSrc: "", vkWatch: "", ytWatch: "" };
      if (!dialog || !frame) return;

      function preferredPlatform() {
        try {
          var saved = localStorage.getItem(playerChoiceKey);
          if (saved === "youtube" || saved === "vk") return saved;
        } catch (error) {}
        return "vk";
      }

      function rememberPlatform(platform) {
        try {
          localStorage.setItem(playerChoiceKey, platform);
        } catch (error) {}
      }

      function params() {
        return new URLSearchParams(location.search);
      }

      function applyFilters() {
        var query = params();
        var playlist = query.get("playlist") || "";
        var occasion = query.get("occasion") || "";
        var shown = 0;
        document.querySelectorAll("[data-video-id]").forEach(function (card) {
          var lists = (card.getAttribute("data-playlists") || "").split(",").filter(Boolean);
          var occasions = (card.getAttribute("data-occasions") || "").split(",").filter(Boolean);
          var ok =
            (!playlist || lists.indexOf(playlist) !== -1) &&
            (!occasion || occasions.indexOf(occasion) !== -1);
          card.hidden = !ok;
          if (ok) shown += 1;
        });
        var empty = document.querySelector("[data-empty]");
        if (empty) empty.hidden = shown !== 0;
        document.querySelectorAll("[data-occasion-banner]").forEach(function (banner) {
          banner.hidden = banner.getAttribute("data-occasion-banner") !== occasion;
        });
        document.querySelectorAll("[data-playlist-banner]").forEach(function (banner) {
          banner.hidden = banner.getAttribute("data-playlist-banner") !== playlist;
        });
        document.querySelectorAll("[data-filter-playlist]").forEach(function (chip) {
          if (chip.getAttribute("data-filter-playlist") === playlist) chip.setAttribute("aria-current", "true");
          else chip.removeAttribute("aria-current");
        });
      }

      function vkEmbed(link) {
        if (!link) return "";
        var oid = link.getAttribute("data-vk-oid");
        var vkId = link.getAttribute("data-vk-id");
        var hash = link.getAttribute("data-vk-hash") || "";
        if (!oid || !vkId || !/^-?\d+$/.test(oid) || !/^\d+$/.test(vkId)) return "";
        var url = "https://vk.com/video_ext.php?oid=" + encodeURIComponent(oid) + "&id=" + encodeURIComponent(vkId) + "&autoplay=1";
        if (hash) url += "&hash=" + encodeURIComponent(hash);
        return url;
      }

      function youtubeIdOf(link) {
        var youtubeId = link && link.getAttribute("data-youtube-id");
        if (youtubeId && !/^[A-Za-z0-9_-]{6,}$/.test(youtubeId)) return "";
        return youtubeId || "";
      }

      function vkWatchUrl(link) {
        if (!link) return "";
        var oid = link.getAttribute("data-vk-oid");
        var vkId = link.getAttribute("data-vk-id");
        if (!oid || !vkId || !/^-?\d+$/.test(oid) || !/^\d+$/.test(vkId)) return "";
        return "https://vk.com/video" + oid + "_" + vkId;
      }

      function setLink(anchor, href) {
        if (!anchor) return;
        if (href) {
          anchor.hidden = false;
          anchor.href = href;
        } else {
          anchor.hidden = true;
          anchor.removeAttribute("href");
        }
      }

      function paintPlatform(platform) {
        var use = platform;
        if (use === "youtube" && !current.ytSrc) use = current.vkSrc ? "vk" : "";
        if (use === "vk" && !current.vkSrc) use = current.ytSrc ? "youtube" : "";
        if (!use) return "";
        frame.replaceChildren();
        var iframe = document.createElement("iframe");
        iframe.className = "player-frame";
        iframe.title = current.title || "Ролик";
        iframe.allowFullscreen = true;
        iframe.referrerPolicy = "strict-origin-when-cross-origin";
        if (use === "youtube") {
          iframe.src = current.ytSrc;
          iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
        } else {
          iframe.src = current.vkSrc;
          iframe.allow = "autoplay; encrypted-media; fullscreen; picture-in-picture; screen-wake-lock";
        }
        frame.append(iframe);
        platformButtons.forEach(function (button) {
          var value = button.getAttribute("data-player-platform");
          var available = value === "youtube" ? Boolean(current.ytSrc) : Boolean(current.vkSrc);
          button.disabled = !available;
          button.setAttribute("aria-pressed", value === use ? "true" : "false");
        });
        return use;
      }

      function openVideo(id, title, link) {
        if (!/^[A-Za-z0-9_-]{6,}$/.test(id)) return;
        var vkSrc = vkEmbed(link);
        var youtubeId = youtubeIdOf(link);
        current = {
          title: title || "Ролик",
          vkSrc: vkSrc,
          ytSrc: youtubeId ? "https://www.youtube-nocookie.com/embed/" + encodeURIComponent(youtubeId) + "?autoplay=1" : "",
          vkWatch: vkWatchUrl(link),
          ytWatch: youtubeId ? "https://www.youtube.com/watch?v=" + encodeURIComponent(youtubeId) : "",
        };
        if (!current.vkSrc && !current.ytSrc) return;
        setLink(vkLink, current.vkWatch);
        setLink(ytLink, current.ytWatch);
        paintPlatform(preferredPlatform());
        var heading = document.getElementById("player-title");
        if (heading) heading.textContent = current.title;
        if (typeof dialog.showModal === "function" && !dialog.open) dialog.showModal();
        var query = params();
        query.set("v", id);
        history.replaceState(null, "", location.pathname + "?" + query.toString());
      }

      platformButtons.forEach(function (button) {
        button.addEventListener("click", function () {
          var platform = button.getAttribute("data-player-platform");
          if (button.disabled || (platform !== "vk" && platform !== "youtube")) return;
          var shown = paintPlatform(platform);
          if (shown === platform) rememberPlatform(platform);
        });
      });

      document.addEventListener("click", function (event) {
        var link = event.target.closest("a[data-video-id]");
        if (!link) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
        event.preventDefault();
        openVideo(link.getAttribute("data-video-id"), link.getAttribute("data-video-title") || "Ролик", link);
      });

      if (closeButton) {
        closeButton.addEventListener("click", function () {
          dialog.close();
        });
      }

      dialog.addEventListener("close", function () {
        frame.replaceChildren();
        var query = params();
        query.delete("v");
        var qs = query.toString();
        history.replaceState(null, "", location.pathname + (qs ? "?" + qs : ""));
      });

      applyFilters();
      var initial = params().get("v");
      if (initial) {
        var link = document.querySelector('[data-video-id="' + CSS.escape(initial) + '"]');
        openVideo(initial, link ? link.getAttribute("data-video-title") : "Ролик", link);
      }
    })();
  </script>
</BaseLayout>
