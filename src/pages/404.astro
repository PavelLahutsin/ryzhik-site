---
import { getEntry } from "astro:content";
import { withBase } from "../lib/base";
import BaseLayout from "../layouts/BaseLayout.astro";

const page = await getEntry("pages", "not-found");
if (!page) throw new Error("Нет текста страницы 404");
const actions = page.data.actions ?? {
  home: "На главную",
  watch: "Смотреть",
  characters: "Персонажи",
};
---

<BaseLayout title={`${page.data.title} — Лисёнок Рыжик`} description={page.data.description} noindex>
  <section class="section">
    <div class="container">
      <p class="eyebrow">{page.data.eyebrow}</p>
      <h1>{page.data.heading}</h1>
      {page.data.lede && <p class="lede">{page.data.lede}</p>}
      <div class="hero-cta" style="margin-top:22px">
        <a class="btn btn-orange" href={withBase("/")}>{actions.home}</a>
        <a class="btn btn-emerald" href={withBase("/watch")}>{actions.watch}</a>
        <a class="btn btn-ghost" href={withBase("/characters")}>{actions.characters}</a>
      </div>
    </div>
  </section>
</BaseLayout>
