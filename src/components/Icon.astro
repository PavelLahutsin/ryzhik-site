---
interface Props {
  name: string;
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {
    name === "play" && (
      <path d="M8.4 5.6 19 12 8.4 18.4Z" fill="currentColor" />
    )
  }
  {
    name === "arrow" && (
      <path
        d="M4 12h14M12.5 6l6 6-6 6"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        fill="none"
      />
    )
  }
  {
    name === "download" && (
      <path
        d="M12 3.5v11M7.2 10.2 12 15l4.8-4.8M4.5 19.5h15"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        fill="none"
      />
    )
  }
  {
    name === "check" && (
      <path
        d="M4.5 12.6 9.4 17.5 19.5 6.5"
        stroke="currentColor"
        stroke-width="2.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        fill="none"
      />
    )
  }
  {
    name === "clock" && (
      <>
        <circle cx="12" cy="12" r="8.6" stroke="currentColor" stroke-width="2" fill="none" />
        <path d="M12 7.4V12l3.2 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" />
      </>
    )
  }
  {
    name === "star" && (
      <path d="M12 3.4 14.7 9.1l6.2.8-4.6 4.3 1.2 6.1L12 17.3 6.5 20.3l1.2-6.1L3.1 9.9l6.2-.8Z" fill="currentColor" />
    )
  }
  {
    name === "heart" && (
      <path
        d="M12 20s-7.5-4.6-7.5-9.4A4.1 4.1 0 0 1 12 8a4.1 4.1 0 0 1 7.5 2.6C19.5 15.4 12 20 12 20Z"
        fill="currentColor"
      />
    )
  }
  {
    name === "music" && (
      <>
        <path d="M9 18V6.5l10-2V15" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" />
        <circle cx="6.6" cy="18" r="2.6" fill="currentColor" />
        <circle cx="16.6" cy="15" r="2.6" fill="currentColor" />
      </>
    )
  }
  {
    name === "paw" && (
      <>
        <ellipse cx="7" cy="8.4" rx="2.2" ry="2.8" fill="currentColor" />
        <ellipse cx="12" cy="6.8" rx="2.2" ry="2.8" fill="currentColor" />
        <ellipse cx="17" cy="8.4" rx="2.2" ry="2.8" fill="currentColor" />
        <path
          d="M12 11.6c3.4 0 5.8 2.2 5.8 4.7 0 2-1.7 3.1-3.6 2.8-1.5-.2-2.9-.2-4.4 0-1.9.3-3.6-.8-3.6-2.8 0-2.5 2.4-4.7 5.8-4.7Z"
          fill="currentColor"
        />
      </>
    )
  }
  {
    name === "youtube" && (
      <>
        <rect x="2" y="5.4" width="20" height="13.2" rx="4.2" fill="currentColor" />
        <path d="M10.2 9.2 15.4 12l-5.2 2.8Z" fill="#fff" />
      </>
    )
  }
  {
    name === "vk" && (
      <text
        x="12"
        y="16.2"
        text-anchor="middle"
        font-size="10"
        font-weight="800"
        font-family="Nunito, sans-serif"
        fill="currentColor"
      >
        VK
      </text>
    )
  }
  {
    name === "rutube" && (
      <>
        <rect x="3" y="6" width="18" height="12" rx="3" fill="currentColor" />
        <path d="M10.5 9.5 15 12l-4.5 2.5Z" fill="#fff" />
      </>
    )
  }
  {
    name === "instagram" && (
      <>
        <rect x="4" y="4" width="16" height="16" rx="5" stroke="currentColor" stroke-width="2" fill="none" />
        <circle cx="12" cy="12" r="3.5" stroke="currentColor" stroke-width="2" fill="none" />
        <circle cx="16.6" cy="7.4" r="1.1" fill="currentColor" />
      </>
    )
  }
  {
    name === "tiktok" && (
      <path
        d="M14 4.2c.4 2.2 1.6 3.6 3.6 4v2.4c-1.2.1-2.3-.2-3.4-.9v5.6c0 3.2-2.4 5.4-5.4 5.4S3.6 18.4 3.6 15.4c0-2.8 2.1-5.1 4.9-5.4v2.6c-1.2.3-2 .9-2 2.1 0 1.3 1 2.2 2.4 2.2 1.5 0 2.5-1 2.5-2.6V4.2H14Z"
        fill="currentColor"
      />
    )
  }
  {
    name === "close" && (
      <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
    )
  }
  {
    name === "shield" && (
      <>
        <path
          d="M12 3 5 6v6c0 4.4 3 7.6 7 9 4-1.4 7-4.6 7-9V6Z"
          stroke="currentColor"
          stroke-width="2"
          stroke-linejoin="round"
          fill="none"
        />
        <path
          d="M8.8 11.9 11 14l4.2-4.3"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          fill="none"
        />
      </>
    )
  }
</svg>
