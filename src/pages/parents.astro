---
import { getEntry, render } from "astro:content";
import Icon from "../components/Icon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { platform } from "../lib/catalog";

const page = await getEntry("pages", "parents");
if (!page?.data.themes) throw new Error("Нет текста страницы для родителей");
const { Content } = await render(page);
const vk = platform("vk");
---

<BaseLayout title={`${page.data.title} — Лисёнок Рыжик`} description={page.data.description}>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">{page.data.eyebrow}</p>
      <h1>{page.data.heading}</h1>
      {page.data.lede && <p class="lede">{page.data.lede}</p>}
    </div>
  </section>

  <section class="section section-tight">
    <div class="container">
      <div class="parents-grid">
        <div>
          <div class="teach-grid">
            {
              page.data.themes.map((theme) => (
                <article class="teach">
                  <span class="tick">
                    <Icon name="check" />
                  </span>
                  <div>
                    <h2>{theme.title}</h2>
                    <p>{theme.text}</p>
                  </div>
                </article>
              ))
            }
          </div>
          <div class="prose">
            <Content />
          </div>
        </div>
        <aside class="aside-card">
          <span class="safe-ico"><Icon name="shield" /></span>
          <h2>{page.data.asideTitle}</h2>
          <p>{page.data.asideLede}</p>
          <ul>
            {
              page.data.asidePoints?.map((point) => (
                <li>
                  <Icon name="star" />
                  <span>
                    <b>{point.title}</b>
                    {point.text}
                  </span>
                </li>
              ))
            }
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <section class="section section-tight faq-section">
    <div class="container">
      <div class="faq-card">
        <div class="faq-header">
          <p class="eyebrow">Частые вопросы</p>
          <h2>Вопросы и ответы</h2>
        </div>
        <div class="faq-list">
          <details class="faq-item">
            <summary class="faq-question">
              <span>Есть ли реклама?</span>
              <span class="faq-chevron" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 9l6 6 6-6" />
                </svg>
              </span>
            </summary>
            <div class="faq-answer">
              <p>
                На самом сайте рекламы нет. Но внутри встроенных плееров VK Видео и YouTube площадки могут показывать собственную рекламу и рекомендации — на это сайт повлиять не может.
              </p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>С какого возраста?</span>
              <span class="faq-chevron" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 9l6 6 6-6" />
                </svg>
              </span>
            </summary>
            <div class="faq-answer">
              <p>0+</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>Как связаться?</span>
              <span class="faq-chevron" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 9l6 6 6-6" />
                </svg>
              </span>
            </summary>
            <div class="faq-answer">
              <p>
                Написать автору можно в сообществе ВКонтакте:{" "}
                <a href={vk.href} target="_blank" rel="noopener noreferrer">
                  {vk.handle}
                </a>.
              </p>
            </div>
          </details>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
