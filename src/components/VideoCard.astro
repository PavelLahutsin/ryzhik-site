---
import { withBase } from "../lib/base";
import Icon from "./Icon.astro";
import { formatDate, formatDuration } from "../lib/format";
import { getDisplayTitle } from "../lib/catalog";

interface Props {
  id: string;
  title: string;
  displayTitle?: string;
  thumbnail: string;
  durationSeconds: number | null;
  uploadDate: string | null;
  href: string;
  playlists?: string[];
  occasions?: string[];
  vk?: { oid: number; id: number; hash: string | null; url: string } | null;
  youtubeId?: string | null;
  heading?: "h2" | "h3";
}

const {
  id,
  title,
  displayTitle,
  thumbnail,
  durationSeconds,
  uploadDate,
  href,
  playlists = [],
  occasions = [],
  vk = null,
  youtubeId = null,
  heading = "h3",
} = Astro.props;

const Heading = heading;
const cardTitle = getDisplayTitle(title, displayTitle);

const duration = formatDuration(durationSeconds);
const date = formatDate(uploadDate);
const cardHref = withBase(href);
const thumbSrc = withBase(thumbnail);
---

<a
  class="episode"
  href={cardHref}
  title={title}
  aria-label={title}
  data-video-id={id}
  data-video-title={title}
  data-playlists={playlists.join(",")}
  data-occasions={occasions.join(",")}
  data-vk-oid={vk ? String(vk.oid) : undefined}
  data-vk-id={vk ? String(vk.id) : undefined}
  data-vk-hash={vk?.hash || undefined}
  data-youtube-id={youtubeId || undefined}
>
  <span class="ep-thumb">
    <img
      src={thumbSrc}
      alt=""
      width="480"
      height="360"
      loading="lazy"
      decoding="async"
    />
    <span class="ep-play"><Icon name="play" /></span>
    {duration && <span class="ep-time">{duration}</span>}
  </span>
  <span class="ep-body">
    <Heading>{cardTitle}</Heading>
    {date && <span class="ep-meta">{date}</span>}
  </span>
</a>
