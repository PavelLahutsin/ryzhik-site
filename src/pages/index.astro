---
import { Picture } from "astro:assets";
import { getCollection, getEntry, render } from "astro:content";
import sample1 from "../assets/coloring/sample-1.webp";
import sample2 from "../assets/coloring/sample-2.webp";
import hedgehog from "../assets/characters/hedgehog.webp";
import ryzhikWave from "../assets/characters/ryzhik-wave.webp";
import familyScene from "../assets/characters/family.webp";
import friendsScene from "../assets/scenes/friends.webp";
import Icon from "../components/Icon.astro";
import PersonaCard from "../components/PersonaCard.astro";
import SampleSheet from "../components/SampleSheet.astro";
import VideoCard from "../components/VideoCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/base";
import { platform, platforms, playlists, publicPlatforms, site, videos } from "../lib/catalog";

const home = await getEntry("pages", "home");
const parents = await getEntry("pages", "parents");
if (!home?.data.hero || !home.data.sections || !parents?.data.themes) {
  throw new Error("Не хватает текстов главной или страницы для родителей");
}

const hero = home.data.hero;
const sections = home.data.sections;
const occasions = (await getCollection("occasions")).sort((a, b) => a.data.order - b.data.order);
const albums = (await getCollection("albums")).sort((a, b) => a.data.order - b.data.order);
const teasers = new Map((home.data.playlistTeasers ?? []).map((item) => [item.id, item.text]));
const characterEntries = (await getCollection("characters")).sort((a, b) => a.data.order - b.data.order);
const characters = await Promise.all(
  characterEntries.map(async (entry) => ({ entry, ...(await render(entry)) })),
);
const family = characters.filter((item) => item.entry.data.group === "family");
const friends = characters.filter((item) => item.entry.data.group === "friends");
const ryzhik = characters.find((item) => item.entry.id === "ryzhik");
if (!ryzhik) throw new Error("Нет персонажа ryzhik");

const latest = [...videos]
  .sort((a, b) => (b.uploadDate || "").localeCompare(a.uploadDate || ""))
  .slice(0, 6);
const themes = parents.data.themes.filter((theme) => theme.home);
const where = publicPlatforms("where");
const youtube = platform("youtube");
const vkVideo = platform("vk-video");
const iconClass: Record<string, string> = {
  youtube: "p-yt",
  vk: "p-vk",
  rutube: "p-ru",
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  inLanguage: "ru",
  url: new URL(import.meta.env.BASE_URL, Astro.site).href,
  description: home.data.description,
  publisher: {
    "@type": "Organization",
    name: site.name,
    sameAs: platforms.filter((item) => item.href && !item.placeholder).map((item) => item.href),
  },
};
---

<BaseLayout title={home.data.title} description={home.data.description} jsonLd={jsonLd}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="hero-badge">
          <b>{hero.badge}</b>
          {hero.badgeText}
        </p>
        <h1>
          {hero.titleBefore}<br />
          <span class="accent">{hero.titleAccent}</span>{" "}
          {hero.titleAfter}
        </h1>
        <p class="hero-slogan">{hero.slogan}</p>
        <div class="hero-cta">
          <a class="btn btn-orange btn-lg hero-primary" href={withBase("/watch")}>
            <Icon name="play" />
            Смотреть здесь
          </a>
          <a class="btn btn-ghost btn-lg" href={withBase("/watch?sleep=1")}>Уложить спать</a>
        </div>
        <p class="hero-alt">
          или:{" "}
          <a href={vkVideo.href} target="_blank" rel="noopener noreferrer">
            {vkVideo.label}
          </a>
          {" · "}
          <a href={youtube.href} target="_blank" rel="noopener noreferrer">
            {youtube.label}
          </a>
        </p>
      </div>
      <div class="hero-figure">
        <Picture
          src={ryzhikWave}
          alt="Лисёнок Рыжик машет лапой"
          widths={[280, 460]}
          sizes="(min-width: 960px) 420px, 220px"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <section class="section" id="collections">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{sections.collectionsEyebrow}</p>
          <h2 class="h2">{sections.collectionsTitle}</h2>
          <p class="lede">{sections.collectionsLede}</p>
        </div>
        <a class="link-more" href={withBase("/watch")}>
          Все ролики
          <Icon name="arrow" />
        </a>
      </div>
      <div class="collections">
        {
          occasions.map((item) => (
            <a class:list={["collection", `c-${item.data.tone}`]} href={withBase(`/watch?occasion=${item.id}`)}>
              <span class="c-ico">
                <Icon name={item.data.icon} />
              </span>
              <span>
                <h3>{item.data.title}</h3>
                <p>{item.data.description}</p>
                <span class="c-foot">
                  Смотреть
                  <Icon name="arrow" />
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-tight" id="playlists">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{sections.playlistsEyebrow}</p>
          <h2 class="h2">{sections.playlistsTitle}</h2>
          <p class="lede">{sections.playlistsLede}</p>
        </div>
      </div>
      <div class="playlist-cards">
        {
          playlists.map((item) => (
            <article class="playlist-card">
              <h3>{item.title}</h3>
              {teasers.get(item.id) && <p>{teasers.get(item.id)}</p>}
              <div class="playlist-actions">
                <a class="btn btn-orange" href={withBase(`/watch?playlist=${item.id}`)}>Смотреть здесь</a>
                <a class="btn btn-ghost" href={item.vkUrl} target="_blank" rel="noopener noreferrer">Плейлист в VK</a>
                <a class="btn btn-ghost" href={item.youtubeUrl} target="_blank" rel="noopener noreferrer">Плейлист на YouTube</a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-tight" id="episodes">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{sections.episodesEyebrow}</p>
          <h2 class="h2">{sections.episodesTitle}</h2>
          <p class="lede">{sections.episodesLede}</p>
        </div>
        <a class="link-more" href={withBase("/watch")}>
          Все серии
          <Icon name="arrow" />
        </a>
      </div>
      <div class="episodes">
        {
          latest.map((video) => (
            <VideoCard
              id={video.id}
              title={video.title}
              displayTitle={video.displayTitle}
              thumbnail={video.thumbnail}
              durationSeconds={video.durationSeconds}
              uploadDate={video.uploadDate}
              href={`/watch?v=${video.id}`}
              playlists={video.playlists}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section heroes-band" id="characters">
    <div class="container">
      {
        home.data.story && (
          <div class="story-block">
            <div class="story-copy">
              <p class="eyebrow">{sections.storyEyebrow}</p>
              <h2 class="h2">{sections.storyTitle}</h2>
              <p class="story-text">{home.data.story}</p>
            </div>
            <div class="peek-friend" aria-hidden="true">
              <Picture
                src={hedgehog}
                alt=""
                widths={[180, 320]}
                sizes="150px"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
              />
            </div>
          </div>
        )
      }
      <div class="section-head">
        <div>
          <p class="eyebrow">{sections.charactersEyebrow}</p>
          <h2 class="h2">{sections.charactersTitle}</h2>
          <p class="lede">{sections.charactersLede}</p>
        </div>
        <a class="link-more" href={withBase("/characters")}>
          Все персонажи
          <Icon name="arrow" />
        </a>
      </div>

      <div class="hero-group">
        <h3>С семьёй</h3>
        <div class="scene-cutout">
          <Picture
            src={familyScene}
            alt="Рыжик с папой, мамой и братиком"
            widths={[480, 800, 1171]}
            sizes="(min-width: 960px) 880px, 92vw"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            loading="lazy"
          />
        </div>
        <div class="personas">
          {family.map((item) => <PersonaCard entry={item.entry} Content={item.Content} />)}
        </div>
      </div>
      <div class="hero-group">
        <h3>С друзьями</h3>
        <div class="scene-photo">
          <Picture
            src={friendsScene}
            alt="Рыжик, белка, ёжик, зайка и медвежонок на поляне"
            widths={[640, 1100, 1600]}
            sizes="(min-width: 960px) 1100px, 92vw"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            loading="lazy"
          />
        </div>
        <div class="personas">
          {friends.map((item) => <PersonaCard entry={item.entry} Content={item.Content} />)}
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="parents">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{sections.parentsEyebrow}</p>
          <h2 class="h2">{sections.parentsTitle}</h2>
          <p class="lede">{sections.parentsLede}</p>
        </div>
        <a class="link-more" href={withBase("/parents")}>
          Подробнее
          <Icon name="arrow" />
        </a>
      </div>
      <div class="parents-grid">
        <div class="teach-grid">
          {
            themes.map((theme) => (
              <article class="teach">
                <span class="tick">
                  <Icon name="check" />
                </span>
                <div>
                  <h3>{theme.title}</h3>
                  <p>{theme.summary}</p>
                </div>
              </article>
            ))
          }
        </div>
        <aside class="aside-card">
          <span class="safe-ico"><Icon name="shield" /></span>
          <h3>{parents.data.asideTitle}</h3>
          <p>{parents.data.asideLede}</p>
          <ul>
            {
              parents.data.asidePoints?.map((point) => (
                <li>
                  <Icon name="star" />
                  <span>
                    <b>{point.title}</b>
                    {point.text}
                  </span>
                </li>
              ))
            }
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <section class="section" id="music">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{sections.musicEyebrow}</p>
          <h2 class="h2">{sections.musicTitle}</h2>
          <p class="lede">{sections.musicLede}</p>
        </div>
        <a class="link-more" href={withBase("/music")}>
          Все альбомы
          <Icon name="arrow" />
        </a>
      </div>
      <div class="album-teasers">
        {
          albums.map((album) => (
            <article class="album-teaser">
              <h3>{album.data.title}</h3>
              {album.data.blurb && <p>{album.data.blurb}</p>}
              <a class="btn btn-orange" href={album.data.href} target="_blank" rel="noopener noreferrer">
                Слушать
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="coloring">
    <div class="container">
      <div class="coloring-wrap">
        <div class="coloring-copy">
          <p class="eyebrow">{sections.coloringEyebrow}</p>
          <h2>{sections.coloringTitle}</h2>
          <p>{sections.coloringLede}</p>
          <div class="coloring-actions">
            <a class="btn btn-orange" href={withBase("/coloring")}>Как получить</a>
          </div>
        </div>
        <div class="coloring-preview">
          <SampleSheet src={sample1} alt="Образец листа раскраски: лисёнок на лесной тропе. Не для печати." />
          <SampleSheet src={sample2} alt="Образец листа раскраски: лисёнок и медвежонок у бревна. Не для печати." />
        </div>
      </div>
    </div>
  </section>

  <section class="section section-tight" id="where">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{sections.whereEyebrow}</p>
          <h2 class="h2">{sections.whereTitle}</h2>
          <p class="lede">{sections.whereLede}</p>
        </div>
      </div>
      <div class="where-grid">
        {
          where.map((item) => (
            <a class="platform" href={item.href} target="_blank" rel="noopener noreferrer">
              <span class:list={["p-logo", iconClass[item.icon] ?? "p-yt"]}>
                <Icon name={item.icon} />
              </span>
              <span>
                <h3>{item.label}</h3>
                <p class="p-sub">{item.handle}</p>
              </span>
              <span class="p-arrow">
                <Icon name="arrow" />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
