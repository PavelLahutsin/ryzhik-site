---
import Icon from "./Icon.astro";
import { formatDate, formatDuration } from "../lib/format";

interface Props {
  id: string;
  title: string;
  thumbnail: string;
  durationSeconds: number | null;
  uploadDate: string | null;
  href: string;
  playlists?: string[];
  occasions?: string[];
  external?: boolean;
  vk?: { oid: number; id: number; hash: string | null; url: string } | null;
  youtubeId?: string | null;
}

const {
  id,
  title,
  thumbnail,
  durationSeconds,
  uploadDate,
  href,
  playlists = [],
  occasions = [],
  external = false,
  vk = null,
  youtubeId = null,
} = Astro.props;

const duration = formatDuration(durationSeconds);
const date = formatDate(uploadDate);
---

<a
  class="episode"
  href={href}
  data-video-id={id}
  data-video-title={title}
  data-playlists={playlists.join(",")}
  data-occasions={occasions.join(",")}
  data-vk-oid={vk ? String(vk.oid) : undefined}
  data-vk-id={vk ? String(vk.id) : undefined}
  data-vk-hash={vk?.hash || undefined}
  data-youtube-id={youtubeId || undefined}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
>
  <span class="ep-thumb">
    <img
      src={thumbnail}
      alt=""
      width="480"
      height="360"
      loading="lazy"
      decoding="async"
    />
    <span class="ep-play"><Icon name="play" /></span>
    {duration && <span class="ep-time">{duration}</span>}
  </span>
  <span class="ep-body">
    <h3>{title}</h3>
    {date && <span class="ep-meta">{date}</span>}
  </span>
</a>
