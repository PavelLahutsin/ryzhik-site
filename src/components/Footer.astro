---
import { Image } from "astro:assets";
import bear from "../assets/characters/bear.webp";
import bunny from "../assets/characters/bunny.webp";
import hedgehog from "../assets/characters/hedgehog.webp";
import ryzhik from "../assets/characters/ryzhik.webp";
import ryzhikWave from "../assets/characters/ryzhik-wave.webp";
import squirrel from "../assets/characters/squirrel.webp";
import { withBase } from "../lib/base";
import { platform, publicPlatforms, site } from "../lib/catalog";
import Icon from "./Icon.astro";

const socials = publicPlatforms("footer");
const vkVideo = platform("vk-video");
const coloring = platform("coloring");
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href={withBase("/")}>
          <span class="brand-mark">
            <Image src={ryzhik} alt="" width={84} format="webp" />
          </span>
          <span>
            <span class="brand-name">{site.name}</span>
            <span class="brand-tag">{site.tagline}</span>
          </span>
        </a>
        <p class="footer-about">{site.footerAbout}</p>
        <div class="footer-socials">
          {
            socials.map((item) => {
              const external = item.href.startsWith("http");
              return (
                <a
                  href={withBase(item.href)}
                  aria-label={item.label}
                  target={external ? "_blank" : undefined}
                  rel={external ? "noopener noreferrer" : undefined}
                >
                  <Icon name={item.icon} />
                </a>
              );
            })
          }
        </div>
      </div>

      <div class="footer-col">
        <h2>Смотреть</h2>
        <ul>
          <li><a href={withBase("/watch?occasion=morning")}>Утро и зарядка</a></li>
          <li><a href={withBase("/watch?occasion=sleep")}>Перед сном</a></li>
          <li><a href={withBase("/watch?occasion=habits")}>Полезные привычки</a></li>
          <li><a href={withBase("/watch?occasion=songs")}>Песенки</a></li>
          <li><a href={withBase("/music")}>Музыка</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h2>Родителям</h2>
        <ul>
          <li><a href={withBase("/parents")}>О чём серии</a></li>
          <li><a href={withBase("/characters")}>Персонажи</a></li>
          <li><a href={withBase("/coloring")}>Раскраски</a></li>
          <li><a href={coloring.href} target="_blank" rel="noopener noreferrer">{coloring.label}</a></li>
          <li><a href={withBase("/privacy")}>Политика конфиденциальности</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h2>Ещё</h2>
        <ul>
          <li><a href={withBase("/watch")}>Все ролики</a></li>
          <li><a href={withBase("/links")}>Все ссылки</a></li>
          <li><a href={withBase("/#where")}>Где смотреть</a></li>
          <li>
            <a href={vkVideo.href} target="_blank" rel="noopener noreferrer">
              {vkVideo.label}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-cast" aria-hidden="true">
      <Image src={hedgehog} alt="" width={150} format="webp" loading="lazy" />
      <Image src={squirrel} alt="" width={150} format="webp" loading="lazy" />
      <Image src={ryzhikWave} alt="" width={170} format="webp" loading="lazy" />
      <Image src={bunny} alt="" width={130} format="webp" loading="lazy" />
      <Image src={bear} alt="" width={150} format="webp" loading="lazy" />
    </div>

    <div class="footer-bottom">
      <span>{site.copyright}</span>
      <span>
        <Icon name="paw" />
        {site.footerSign}
      </span>
    </div>
  </div>
</footer>
