---
import { getCollection, getEntry } from "astro:content";
import Icon from "../components/Icon.astro";
import VideoCard from "../components/VideoCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/base";
import { occasionIds, platform, playlists, videos } from "../lib/catalog";

const page = await getEntry("pages", "watch");
if (!page) throw new Error("Нет текста страницы watch");

const occasions = (await getCollection("occasions")).sort((a, b) => a.data.order - b.data.order);
const vkVideo = platform("vk-video");
const youtube = platform("youtube");
const cards = videos.map((video) => ({
  video,
  occasions: occasionIds(video.title, occasions, video.occasions),
}));
---

<BaseLayout title={`${page.data.title} — Лисёнок Рыжик`} description={page.data.description}>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">{page.data.eyebrow}</p>
      <h1>{page.data.heading}</h1>
      {page.data.lede && <p class="lede">{page.data.lede}</p>}
    </div>
  </section>

  <section class="section section-tight">
    <div class="container">
      <!-- 1. Поиск: поле «Найти серию» -->
      <div class="watch-search-wrap">
        <div class="watch-search-box">
          <svg class="search-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            type="search"
            id="watch-search"
            class="watch-search-input"
            placeholder="Найти серию"
            aria-label="Найти серию"
            autocomplete="off"
          />
          <button type="button" class="search-clear-btn" aria-label="Очистить поиск" hidden data-search-clear>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
      </div>

      <!-- 2. Чипсы -->
      <nav class="chips occasion-filters" aria-label="Подборки и плейлисты">
        <a
          class="chip"
          href={withBase("/watch")}
          data-filter-occasion=""
          data-filter-all
          aria-current={!Astro.url.searchParams.has("occasion") && !Astro.url.searchParams.has("playlist") ? "true" : undefined}
        >
          Все
        </a>
        {
          occasions.map((item) => (
            <a
              class="chip"
              href={withBase(`/watch?occasion=${encodeURIComponent(item.id)}`)}
              data-filter-occasion={item.id}
              aria-current={Astro.url.searchParams.get("occasion") === item.id ? "true" : undefined}
            >
              {item.data.title}
            </a>
          ))
        }
        {
          playlists.map((item) => (
            <a
              class="chip"
              href={withBase(`/watch?playlist=${item.id}`)}
              data-filter-playlist={item.id}
              aria-current={Astro.url.searchParams.get("playlist") === item.id ? "true" : undefined}
            >
              {item.title}
            </a>
          ))
        }
      </nav>

      {
        occasions.map((item) => (
          <p class="filter-banner" data-occasion-banner={item.id} hidden>
            Подборка: {item.data.title}{" "}
            <a href={withBase("/watch")}>Показать все</a>
          </p>
        ))
      }

      <!-- Состояние «Ничего не нашлось» с кнопкой «Сбросить» -->
      <div class="empty-state" data-empty hidden>
        <p class="empty-title">Ничего не нашлось</p>
        <button type="button" class="btn btn-orange" data-reset-filters>Сбросить</button>
      </div>

      <!-- 3. Сетка роликов -->
      <div class="episodes">
        {
          cards.map(({ video, occasions: tags }) => (
            <VideoCard
              id={video.id}
              title={video.title}
              displayTitle={video.displayTitle}
              thumbnail={video.thumbnail}
              durationSeconds={video.durationSeconds}
              uploadDate={video.uploadDate}
              href={`/watch?v=${video.id}`}
              playlists={video.playlists}
              occasions={tags}
              vk={video.vk}
              youtubeId={video.youtubeId}
              heading="h2"
            />
          ))
        }
      </div>

      <!-- 4. Описания плейлистов и ссылки «Плейлист в VK / на YouTube» сожты и перенесены ниже сетки -->
      <div class="watch-playlists-summary" aria-labelledby="playlists-summary-heading">
        <h2 id="playlists-summary-heading" class="playlists-summary-heading">Плейлисты серий</h2>
        <div class="playlists-summary-grid">
          {
            playlists.map((item) => {
              const intro = page.data.playlistIntros?.find((p) => p.id === item.id);
              return (
                <article class="playlist-summary-card">
                  <div>
                    <h3>{item.title}</h3>
                    {intro && <p>{intro.text}</p>}
                  </div>
                  <div class="playlist-summary-links">
                    <a href={item.vkUrl} target="_blank" rel="noopener noreferrer">
                      <Icon name="vk" />
                      Плейлист в VK
                    </a>
                    <a href={item.youtubeUrl} target="_blank" rel="noopener noreferrer">
                      <Icon name="youtube" />
                      Плейлист на YouTube
                    </a>
                  </div>
                </article>
              );
            })
          }
        </div>
      </div>
    </div>
  </section>

  <dialog class="player-dialog" id="player-dialog" aria-labelledby="player-title" aria-modal="true">
    <div class="player-sheet">
      <h2 id="player-title" class="sr-only">Просмотр ролика</h2>
      <button class="player-x" type="button" aria-label="Закрыть" data-player-x>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            d="M6 6 18 18M18 6 6 18"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            fill="none"></path>
        </svg>
      </button>
      <div data-player-frame></div>

      <!-- Таймер сна: для роликов из плейлистов «Колыбельные» и «Сонные истории» -->
      <div class="player-sleep-bar" data-sleep-timer-wrap hidden>
        <span class="sleep-label">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          Выключить через:
        </span>
        <div class="sleep-options" role="radiogroup" aria-label="Таймер сна">
          <button type="button" class="sleep-chip" data-sleep-val="15" role="radio" aria-checked="false">15 мин</button>
          <button type="button" class="sleep-chip" data-sleep-val="30" role="radio" aria-checked="false">30 мин</button>
          <button type="button" class="sleep-chip" data-sleep-val="60" role="radio" aria-checked="false">60 мин</button>
          <button type="button" class="sleep-chip" data-sleep-val="off" role="radio" aria-checked="true">выкл</button>
        </div>
      </div>

      <div class="player-toolbar">
        <div class="player-switch" role="group" aria-label="Плеер">
          <button type="button" data-player-platform="vk" aria-pressed="true">VK</button>
          <button type="button" data-player-platform="youtube" aria-pressed="false">YouTube</button>
        </div>
        <button class="btn btn-emerald player-next-btn" type="button" data-player-next aria-label="Следующая серия">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M5 5v14l10-7L5 5zM17 5v14h2V5h-2z"></path>
          </svg>
          <span>Следующая серия</span>
        </button>
        <button class="btn btn-ghost player-share-btn" type="button" data-player-share aria-label="Поделиться">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle>
            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
          </svg>
          <span data-share-label>Поделиться</span>
        </button>
        <button class="btn btn-ghost" type="button" data-player-close>Закрыть</button>
      </div>

      <div class="player-links">
        <a class="btn btn-emerald" data-player-vk href={vkVideo.href} target="_blank" rel="noopener noreferrer">
          <Icon name="vk" />
          Открыть в VK
        </a>
        <a class="btn btn-orange" data-player-yt href={youtube.href} target="_blank" rel="noopener noreferrer">
          <Icon name="youtube" />
          Открыть на YouTube
        </a>
      </div>
    </div>
  </dialog>

  <script is:inline>
    (function () {
      var dialog = document.getElementById("player-dialog");
      var frame = document.querySelector("[data-player-frame]");
      var closeButton = document.querySelector("[data-player-close]");
      var xButton = document.querySelector("[data-player-x]");
      var nextButton = document.querySelector("[data-player-next]");
      var shareButton = document.querySelector("[data-player-share]");
      var shareLabel = document.querySelector("[data-share-label]");
      var sleepTimerWrap = document.querySelector("[data-sleep-timer-wrap]");
      var sleepChips = document.querySelectorAll("[data-sleep-val]");
      var searchInput = document.getElementById("watch-search");
      var searchClearBtn = document.querySelector("[data-search-clear]");
      var resetButtons = document.querySelectorAll("[data-reset-filters]");

      var lastTrigger = null;      // карточка, с которой открыли плеер
      var historyPushed = false;   // мы добавили запись истории для этого ролика
      var closedByHistory = false; // закрытие пришло от popstate
      var expectingOwnBack = false; // мы сами вызвали history.back()
      var vkLink = document.querySelector("[data-player-vk]");
      var ytLink = document.querySelector("[data-player-yt]");
      var platformButtons = document.querySelectorAll("[data-player-platform]");
      var playerChoiceKey = "ryzhik-player";
      var sleepTimerKey = "ryzhik-sleep-timer";

      var current = { id: "", title: "", vkSrc: "", ytSrc: "", vkWatch: "", ytWatch: "" };
      var shareTimeout = null;
      var sleepTimerId = null;

      if (!dialog || !frame) return;

      var vkTimeZones = [
        "Europe/Kaliningrad",
        "Europe/Moscow",
        "Europe/Simferopol",
        "Europe/Kirov",
        "Europe/Volgograd",
        "Europe/Astrakhan",
        "Europe/Saratov",
        "Europe/Ulyanovsk",
        "Europe/Samara",
        "Europe/Minsk",
        "Asia/Yekaterinburg",
        "Asia/Omsk",
        "Asia/Novosibirsk",
        "Asia/Barnaul",
        "Asia/Tomsk",
        "Asia/Novokuznetsk",
        "Asia/Krasnoyarsk",
        "Asia/Irkutsk",
        "Asia/Chita",
        "Asia/Yakutsk",
        "Asia/Khandyga",
        "Asia/Vladivostok",
        "Asia/Ust-Nera",
        "Asia/Magadan",
        "Asia/Sakhalin",
        "Asia/Srednekolymsk",
        "Asia/Kamchatka",
        "Asia/Anadyr",
        "Asia/Almaty",
        "Asia/Aqtobe",
        "Asia/Aqtau",
        "Asia/Atyrau",
        "Asia/Oral",
        "Asia/Qostanay",
        "Asia/Qyzylorda",
      ];

      function preferredPlatform() {
        try {
          var saved = localStorage.getItem(playerChoiceKey);
          if (saved === "youtube" || saved === "vk") return saved;
        } catch (error) {}

        var langs = [];
        try {
          if (navigator.languages && navigator.languages.length) langs = Array.from(navigator.languages);
          else if (navigator.language) langs = [navigator.language];
        } catch (error) {}

        var regionalLanguage = langs.some(function (lang) {
          var primary = String(lang || "").toLowerCase().split("-")[0];
          return primary === "ru" || primary === "be" || primary === "kk";
        });

        var timeZone = "";
        try {
          timeZone = Intl.DateTimeFormat().resolvedOptions().timeZone || "";
        } catch (error) {}

        if (regionalLanguage || vkTimeZones.indexOf(timeZone) !== -1) return "vk";
        if (!langs.length || !timeZone || timeZone === "UTC" || timeZone === "Etc/UTC" || timeZone === "Etc/GMT") return "vk";
        return "youtube";
      }

      function rememberPlatform(platform) {
        try {
          localStorage.setItem(playerChoiceKey, platform);
        } catch (error) {}
      }

      function params() {
        return new URLSearchParams(location.search);
      }

      function cleanText(str) {
        return (str || "")
          .toLowerCase()
          .replace(/ё/g, "е")
          .replace(/[\p{P}\p{S}]/gu, " ")
          .replace(/\s+/g, " ")
          .trim();
      }

      function applyFilters() {
        var query = params();
        var playlist = query.get("playlist") || "";
        var occasion = query.get("occasion") || "";
        var searchVal = searchInput ? searchInput.value : "";
        var searchTerm = cleanText(searchVal);

        if (searchClearBtn) {
          searchClearBtn.hidden = !searchVal;
        }

        var shown = 0;
        document.querySelectorAll("[data-video-id]").forEach(function (card) {
          var lists = (card.getAttribute("data-playlists") || "").split(",").filter(Boolean);
          var occasions = (card.getAttribute("data-occasions") || "").split(",").filter(Boolean);
          var title = card.getAttribute("data-video-title") || "";
          var displayHeading = card.querySelector("h2, h3");
          var headingText = displayHeading ? displayHeading.textContent : "";
          var normalizedCardTitle = cleanText(title + " " + headingText);

          var matchesPlaylist = !playlist || lists.indexOf(playlist) !== -1;
          var matchesOccasion = !occasion || occasions.indexOf(occasion) !== -1;
          var matchesSearch = !searchTerm || normalizedCardTitle.indexOf(searchTerm) !== -1;

          var ok = matchesPlaylist && matchesOccasion && matchesSearch;
          card.hidden = !ok;
          if (ok) shown += 1;
        });

        var empty = document.querySelector("[data-empty]");
        if (empty) empty.hidden = (shown !== 0);

        document.querySelectorAll("[data-occasion-banner]").forEach(function (banner) {
          banner.hidden = banner.getAttribute("data-occasion-banner") !== occasion;
        });
        document.querySelectorAll("[data-playlist-banner]").forEach(function (banner) {
          banner.hidden = banner.getAttribute("data-playlist-banner") !== playlist;
        });
        document.querySelectorAll("[data-filter-playlist]").forEach(function (chip) {
          if (chip.getAttribute("data-filter-playlist") === playlist) chip.setAttribute("aria-current", "true");
          else chip.removeAttribute("aria-current");
        });
        document.querySelectorAll("[data-filter-occasion]").forEach(function (chip) {
          if (chip.getAttribute("data-filter-occasion") === occasion) chip.setAttribute("aria-current", "true");
          else chip.removeAttribute("aria-current");
        });
        document.querySelectorAll("[data-filter-all]").forEach(function (chip) {
          if (!playlist && !occasion) chip.setAttribute("aria-current", "true");
          else chip.removeAttribute("aria-current");
        });
      }

      function resetFilters() {
        if (searchInput) searchInput.value = "";
        var query = params();
        query.delete("playlist");
        query.delete("occasion");
        var qs = query.toString();
        history.replaceState(history.state, "", location.pathname + (qs ? "?" + qs : ""));
        applyFilters();
        if (searchInput) searchInput.focus();
      }

      function vkEmbed(link) {
        if (!link) return "";
        var oid = link.getAttribute("data-vk-oid");
        var vkId = link.getAttribute("data-vk-id");
        var hash = link.getAttribute("data-vk-hash") || "";
        if (!oid || !vkId || !/^-?\d+$/.test(oid) || !/^\d+$/.test(vkId)) return "";
        var url = "https://vk.com/video_ext.php?oid=" + encodeURIComponent(oid) + "&id=" + encodeURIComponent(vkId) + "&autoplay=1";
        if (hash) url += "&hash=" + encodeURIComponent(hash);
        return url;
      }

      function youtubeIdOf(link) {
        var youtubeId = link && link.getAttribute("data-youtube-id");
        if (youtubeId && !/^[A-Za-z0-9_-]{6,}$/.test(youtubeId)) return "";
        return youtubeId || "";
      }

      function vkWatchUrl(link) {
        if (!link) return "";
        var oid = link.getAttribute("data-vk-oid");
        var vkId = link.getAttribute("data-vk-id");
        if (!oid || !vkId || !/^-?\d+$/.test(oid) || !/^\d+$/.test(vkId)) return "";
        return "https://vk.com/video" + oid + "_" + vkId;
      }

      function setLink(anchor, href) {
        if (!anchor) return;
        if (href) {
          anchor.hidden = false;
          anchor.href = href;
        } else {
          anchor.hidden = true;
          anchor.removeAttribute("href");
        }
      }

      function paintPlatform(platform) {
        var use = platform;
        if (use === "youtube" && !current.ytSrc) use = current.vkSrc ? "vk" : "";
        if (use === "vk" && !current.vkSrc) use = current.ytSrc ? "youtube" : "";
        if (!use) return "";
        frame.replaceChildren();
        var iframe = document.createElement("iframe");
        iframe.className = "player-frame";
        iframe.title = current.title || "Ролик";
        iframe.allowFullscreen = true;
        iframe.referrerPolicy = "strict-origin-when-cross-origin";
        if (use === "youtube") {
          iframe.src = current.ytSrc;
          iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
        } else {
          iframe.src = current.vkSrc;
          iframe.allow = "autoplay; encrypted-media; fullscreen; picture-in-picture; screen-wake-lock";
        }
        frame.append(iframe);
        platformButtons.forEach(function (button) {
          var value = button.getAttribute("data-player-platform");
          var available = value === "youtube" ? Boolean(current.ytSrc) : Boolean(current.vkSrc);
          button.disabled = !available;
          button.setAttribute("aria-pressed", value === use ? "true" : "false");
        });
        return use;
      }

      function dropVideoParam() {
        var query = params();
        query.delete("v");
        var qs = query.toString();
        history.replaceState(history.state, "", location.pathname + (qs ? "?" + qs : ""));
      }

      /* Sleep timer logic for lullabies and bedtime stories (playlists 2 and 3) */
      function isSleepPlaylistVideo(link) {
        if (!link) return false;
        var pls = (link.getAttribute("data-playlists") || "").split(",").filter(Boolean);
        var occs = (link.getAttribute("data-occasions") || "").split(",").filter(Boolean);
        return pls.indexOf("2") !== -1 || pls.indexOf("3") !== -1 || occs.indexOf("sleep") !== -1;
      }

      function updateSleepUI(val) {
        sleepChips.forEach(function (chip) {
          var chipVal = chip.getAttribute("data-sleep-val");
          var isCurrent = chipVal === val;
          chip.setAttribute("aria-checked", isCurrent ? "true" : "false");
        });
      }

      function clearSleepTimer() {
        if (sleepTimerId) {
          clearTimeout(sleepTimerId);
          sleepTimerId = null;
        }
      }

      function setSleepTimer(minutes) {
        clearSleepTimer();
        if (!minutes || minutes <= 0) return;
        sleepTimerId = setTimeout(function () {
          clearSleepTimer();
          closePlayer();
        }, minutes * 60 * 1000);
      }

      function configureSleepTimer(link) {
        if (!sleepTimerWrap) return;
        var eligible = isSleepPlaylistVideo(link);
        sleepTimerWrap.hidden = !eligible;
        if (!eligible) {
          clearSleepTimer();
          return;
        }

        var savedVal = "off";
        try {
          savedVal = localStorage.getItem(sleepTimerKey) || "off";
        } catch (e) {}

        updateSleepUI(savedVal);
        if (savedVal !== "off" && !sleepTimerId) {
          setSleepTimer(parseInt(savedVal, 10));
        }
      }

      sleepChips.forEach(function (chip) {
        chip.addEventListener("click", function () {
          var val = chip.getAttribute("data-sleep-val") || "off";
          try {
            localStorage.setItem(sleepTimerKey, val);
          } catch (e) {}
          updateSleepUI(val);
          if (val === "off") {
            clearSleepTimer();
          } else {
            setSleepTimer(parseInt(val, 10));
          }
        });
      });

      /* Next episode selection: next from same playlist/occasion, else next in catalog */
      function getNextVideoCard(currentId) {
        var allCards = Array.from(document.querySelectorAll("[data-video-id]"));
        if (!allCards.length) return null;

        var currentCard = allCards.find(function (c) {
          return c.getAttribute("data-video-id") === currentId;
        });
        if (!currentCard) return allCards[0];

        var query = params();
        var activePlaylist = query.get("playlist") || "";
        var activeOccasion = query.get("occasion") || "";
        var subset = [];

        if (activeOccasion) {
          subset = allCards.filter(function (c) {
            var occs = (c.getAttribute("data-occasions") || "").split(",").filter(Boolean);
            return occs.indexOf(activeOccasion) !== -1;
          });
        } else if (activePlaylist) {
          subset = allCards.filter(function (c) {
            var pls = (c.getAttribute("data-playlists") || "").split(",").filter(Boolean);
            return pls.indexOf(activePlaylist) !== -1;
          });
        } else {
          var pls = (currentCard.getAttribute("data-playlists") || "").split(",").filter(Boolean);
          if (pls.length > 0) {
            var firstPl = pls[0];
            subset = allCards.filter(function (c) {
              var p = (c.getAttribute("data-playlists") || "").split(",").filter(Boolean);
              return p.indexOf(firstPl) !== -1;
            });
          }
          if (!subset.length) {
            var occs = (currentCard.getAttribute("data-occasions") || "").split(",").filter(Boolean);
            if (occs.length > 0) {
              var firstOcc = occs[0];
              subset = allCards.filter(function (c) {
                var o = (c.getAttribute("data-occasions") || "").split(",").filter(Boolean);
                return o.indexOf(firstOcc) !== -1;
              });
            }
          }
        }

        if (subset.length > 1) {
          var idx = subset.indexOf(currentCard);
          if (idx !== -1 && idx + 1 < subset.length) {
            return subset[idx + 1];
          }
        }

        var globalIdx = allCards.indexOf(currentCard);
        return allCards[(globalIdx + 1) % allCards.length];
      }

      function openVideo(id, title, link, trigger, push) {
        if (!/^[A-Za-z0-9_-]{6,}$/.test(id)) return;
        var vkSrc = vkEmbed(link);
        var youtubeId = youtubeIdOf(link);
        current = {
          id: id,
          title: title || "Ролик",
          vkSrc: vkSrc,
          ytSrc: youtubeId ? "https://www.youtube-nocookie.com/embed/" + encodeURIComponent(youtubeId) + "?autoplay=1" : "",
          vkWatch: vkWatchUrl(link),
          ytWatch: youtubeId ? "https://www.youtube.com/watch?v=" + encodeURIComponent(youtubeId) : "",
        };
        if (!current.vkSrc && !current.ytSrc) return;
        setLink(vkLink, current.vkWatch);
        setLink(ytLink, current.ytWatch);
        paintPlatform(preferredPlatform());
        var heading = document.getElementById("player-title");
        if (heading) heading.textContent = current.title;
        if (trigger !== undefined) lastTrigger = trigger;

        configureSleepTimer(link);

        var wasOpen = dialog.open;
        if (typeof dialog.showModal === "function" && !wasOpen) dialog.showModal();
        var query = params();
        query.set("v", id);
        var url = location.pathname + "?" + query.toString();
        if (wasOpen || push === false) {
          // Смена ролика в открытом плеере или прямая ссылка ?v=...: без новой записи.
          history.replaceState(history.state, "", url);
        } else {
          history.pushState({ ryzhikPlayer: true }, "", url);
          historyPushed = true;
        }
      }

      function closePlayer() {
        if (dialog.open) dialog.close();
      }

      /* Share button */
      function copyText(text) {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          return navigator.clipboard.writeText(text);
        }
        return new Promise(function (resolve, reject) {
          try {
            var textarea = document.createElement("textarea");
            textarea.value = text;
            textarea.style.position = "fixed";
            textarea.style.opacity = "0";
            document.body.appendChild(textarea);
            textarea.focus();
            textarea.select();
            var success = document.execCommand("copy");
            document.body.removeChild(textarea);
            if (success) resolve();
            else reject(new Error("Copy failed"));
          } catch (err) {
            reject(err);
          }
        });
      }

      function setCopiedBadge() {
        if (shareLabel) shareLabel.textContent = "Ссылка скопирована";
        if (shareTimeout) clearTimeout(shareTimeout);
        shareTimeout = setTimeout(function () {
          if (shareLabel) shareLabel.textContent = "Поделиться";
        }, 2500);
      }

      if (shareButton) {
        shareButton.addEventListener("click", function () {
          var shareUrl = window.location.href;
          var title = current.title || document.title;
          if (navigator.share) {
            navigator.share({
              title: title,
              url: shareUrl,
            }).catch(function () {});
          } else {
            copyText(shareUrl)
              .then(setCopiedBadge)
              .catch(function () {
                window.prompt("Скопируйте ссылку на серию:", shareUrl);
              });
          }
        });
      }

      if (nextButton) {
        nextButton.addEventListener("click", function () {
          var nextCard = getNextVideoCard(current.id);
          if (nextCard) {
            openVideo(
              nextCard.getAttribute("data-video-id"),
              nextCard.getAttribute("data-video-title") || "Ролик",
              nextCard,
              nextCard,
              true,
            );
          }
        });
      }

      platformButtons.forEach(function (button) {
        button.addEventListener("click", function () {
          var platform = button.getAttribute("data-player-platform");
          if (button.disabled || (platform !== "vk" && platform !== "youtube")) return;
          var shown = paintPlatform(platform);
          if (shown === platform) rememberPlatform(platform);
        });
      });

      document.addEventListener("click", function (event) {
        var link = event.target.closest("a[data-video-id]");
        if (!link) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
        event.preventDefault();
        openVideo(
          link.getAttribute("data-video-id"),
          link.getAttribute("data-video-title") || "Ролик",
          link,
          link,
          true,
        );
      });

      if (closeButton) closeButton.addEventListener("click", closePlayer);
      if (xButton) xButton.addEventListener("click", closePlayer);

      // Escape ловим на window, пока диалог открыт
      window.addEventListener("keydown", function (event) {
        if (!dialog.open) return;
        if (event.key === "Escape" || event.key === "Esc") {
          event.preventDefault();
          closePlayer();
        }
      });

      dialog.addEventListener("cancel", function (event) {
        event.preventDefault();
        closePlayer();
      });

      dialog.addEventListener("close", function () {
        frame.replaceChildren();
        clearSleepTimer();
        var fromHistory = closedByHistory;
        closedByHistory = false;
        if (fromHistory) {
          historyPushed = false;
        } else if (historyPushed) {
          historyPushed = false;
          expectingOwnBack = true;
          history.back();
        } else {
          dropVideoParam();
        }
        var target = lastTrigger;
        lastTrigger = null;
        if (target && typeof target.focus === "function" && target.isConnected) {
          target.focus({ preventScroll: true });
        }
      });

      // Кнопка/жест «Назад» закрывает плеер
      window.addEventListener("popstate", function () {
        if (expectingOwnBack) {
          expectingOwnBack = false;
          return;
        }
        if (dialog.open) {
          closedByHistory = true;
          closePlayer();
          return;
        }
        var v = params().get("v");
        if (v) {
          var card = document.querySelector('[data-video-id="' + CSS.escape(v) + '"]');
          openVideo(v, card ? card.getAttribute("data-video-title") : "Ролик", card, card, false);
        }
      });

      // Поиск: живой фильтр
      if (searchInput) {
        searchInput.addEventListener("input", applyFilters);
        searchInput.addEventListener("search", applyFilters);
      }
      if (searchClearBtn) {
        searchClearBtn.addEventListener("click", function () {
          if (searchInput) {
            searchInput.value = "";
            searchInput.focus();
            applyFilters();
          }
        });
      }

      resetButtons.forEach(function (btn) {
        btn.addEventListener("click", resetFilters);
      });

      applyFilters();

      var initial = params().get("v");
      if (initial) {
        var initialCard = document.querySelector('[data-video-id="' + CSS.escape(initial) + '"]');
        openVideo(initial, initialCard ? initialCard.getAttribute("data-video-title") : "Ролик", initialCard, initialCard, false);
      }
    })();
  </script>
</BaseLayout>
