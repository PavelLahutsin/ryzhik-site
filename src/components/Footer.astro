---
import { Image } from "astro:assets";
import ryzhik from "../assets/characters/ryzhik.webp";
import { platform, publicPlatforms, site } from "../lib/catalog";
import Icon from "./Icon.astro";

const socials = publicPlatforms("footer");
const vkVideo = platform("vk-video");
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href="/">
          <span class="brand-mark">
            <Image src={ryzhik} alt="" width={84} format="webp" />
          </span>
          <span>
            <span class="brand-name">{site.name}</span>
            <span class="brand-tag">{site.tagline}</span>
          </span>
        </a>
        <p class="footer-about">{site.footerAbout}</p>
        <div class="footer-socials">
          {
            socials.map((item) => {
              const external = item.href.startsWith("http");
              return (
                <a
                  href={item.href}
                  aria-label={item.label}
                  target={external ? "_blank" : undefined}
                  rel={external ? "noopener noreferrer" : undefined}
                >
                  <Icon name={item.icon} />
                </a>
              );
            })
          }
        </div>
      </div>

      <div class="footer-col">
        <h2>Смотреть</h2>
        <ul>
          <li><a href="/watch?occasion=morning">Утро и зарядка</a></li>
          <li><a href="/watch?occasion=sleep">Перед сном</a></li>
          <li><a href="/watch?occasion=habits">Полезные привычки</a></li>
          <li><a href="/watch?occasion=songs">Песенки</a></li>
          <li><a href="/music">Музыка</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h2>Родителям</h2>
        <ul>
          <li><a href="/parents">О чём серии</a></li>
          <li><a href="/characters">Персонажи</a></li>
          <li><a href="/coloring">Раскраски</a></li>
          <li><a href="/privacy">Политика конфиденциальности</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h2>Ещё</h2>
        <ul>
          <li><a href="/watch">Все ролики</a></li>
          <li><a href="/links">Все ссылки</a></li>
          <li><a href="/#where">Где смотреть</a></li>
          <li>
            <a href={vkVideo.href} target="_blank" rel="noopener noreferrer">
              {vkVideo.label}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>{site.copyright}</span>
      <span>
        <Icon name="paw" />
        {site.footerSign}
      </span>
    </div>
  </div>
</footer>
